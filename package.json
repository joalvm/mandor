{
    "name": "mandor",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "engines": {
        "node": ">=26.0.0",
        "npm": ">=11.0.0"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "build": "node tools/turbo.mjs run build",
        "unused": "knip --no-progress",
        "duplicates": "jscpd --config .jscpd.json",
        "check": "node tools/check.mjs",
        "ci:build": "docker compose -f compose.ci.yaml build ci",
        "ci:local": "node tools/ci/docker-ci.mjs ci",
        "ci:verify": "node tools/ci/docker-ci.mjs verify",
        "ci:e2e": "node tools/ci/docker-ci.mjs e2e",
        "ci:installers": "node tools/ci/docker-ci.mjs installers",
        "ci:qa": "node tools/ci/docker-ci.mjs qa",
        "ci:test": "node tools/ci/docker-ci.mjs test",
        "ci:check": "node tools/ci/docker-ci.mjs check",
        "dev:async": "npm run dev --workspace @mandor/async",
        "dev:sync": "npm run dev --workspace @mandor/sync",
        "dev:lab": "vite tools/ui-lab",
        "test": "vitest run --project=dom* --project=node --project=node-isolated && vitest run --coverage --project=node-core*",
        "test:node": "vitest run --project=node*",
        "lint": "node tools/lint.mjs",
        "typecheck": "node tools/typecheck.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "icons": "npm run icons --workspace @mandor/icons --",
        "i18n": "npm run i18n --workspace @mandor/i18n --",
        "depcruise": "depcruise packages apps tools --config .dependency-cruiser.cjs && node tools/frontier/warn-repeated-symbols.mjs",
        "design": "node tools/design/check-design.mjs",
        "guards": "node tools/guards/check-guards.mjs",
        "plans": "node tools/plans/check-plans.mjs",
        "qa": "node tools/pull-request/check-pull-request.mjs",
        "tokens": "npm run tokens --workspace @mandor/ui --",
        "test:watch": "vitest",
        "verify": "node tools/verify.mjs",
        "verify:checks": "node tools/verify.mjs checks",
        "verify:tests-build": "node tools/verify.mjs tests-build",
        "skills:link": "node tools/link-agent-skills.mjs",
        "deps:upgrade": "ncu -u && npm install --foreground-scripts && npm audit"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "6.0.1",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@typescript-eslint/parser": "8.73.0",
        "@vitest/coverage-v8": "5.1.1",
        "dependency-cruiser": "18.8.0",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "jscpd": "5.4.3",
        "jsdom": "31.0.1",
        "jsonc-parser": "3.3.1",
        "knip": "6.46.1",
        "npm-check-updates": "23.1.1",
        "prettier": "3.10.1",
        "shiki": "4.6.0",
        "turbo": "2.11.13",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "typescript-native": "npm:typescript@7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1",
        "yaml": "2.9.1",
        "zustand": "5.1.0"
    },
    "packageManager": "npm@11.20.0",
    "overrides": {
        "cookie@~0.4.1": "0.7.2",
        "debug@~4.1.0": "4.4.3",
        "dompurify": "3.4.17",
        "js-beautify": {
            "glob": "14.0.3"
        },
        "minimatch@^9.0.3": "11.0.5",
        "minimatch@^10": "11.0.5",
        "parseuri": "file:packages/transport-async/vendor/parseuri",
        "react-dom": "19.3.1",
        "react": "19.3.1"
    },
    "allowScripts": {
        "@scarf/scarf": false,
        "electron-winstaller": false
    }
}
